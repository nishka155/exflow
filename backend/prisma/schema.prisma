// ExFlow — Export Logistics Operating System
// Prisma schema: source of truth for the Postgres data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EXPORT_MANAGER
  DOCUMENTATION_EXECUTIVE
  FACTORY_USER
  TRANSPORT_COORDINATOR
  ACCOUNTS
  CUSTOMER
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  COMPLETED
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  REACHED_FACTORY
  DELAY
}

enum ContainerSize {
  FT20
  FT40
  FT40_HC
}

enum StuffingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum GateInStatus {
  PENDING
  COMPLETED
}

enum SIStatus {
  DRAFT
  SENT
  CONFIRMED
}

enum BLStatus {
  DRAFT
  MISMATCH
  FINAL
}

enum SobStatus {
  PENDING
  COMPLETED
}

enum InventoryMovementType {
  IN
  OUT
}

enum BookingStage {
  INVOICE
  DISPATCH
  STUFFING
  GATE_IN
  SHIPPING_INSTRUCTION
  BILL_OF_LADING
  SOB
  COMPLETED
}

enum DocumentCategory {
  INVOICE
  PACKING_LIST
  BILL_OF_LADING
  SHIPPING_INSTRUCTION
  LR_COPY
  GR_COPY
  GATE_PASS
  PHOTO
  CONTAINER_PHOTO
  LOADING_PHOTO
  SEAL_PHOTO
  VIDEO
  CERTIFICATE
  STUFFING_REPORT
  OTHER
}

enum DocumentEntityType {
  BOOKING
  INVOICE
  DISPATCH
  STUFFING
  GATE_IN
  SHIPPING_INSTRUCTION
  BILL_OF_LADING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationType {
  TRUCK_DELAY
  GATE_IN_DELAY
  MISSING_DOCUMENTS
  PENDING_SI
  PENDING_BL
  SEAL_MISSING
  CONTAINER_DELAY
  GENERAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  customers            Customer[]
  transporters         Transporter[]
  bookings             Booking[]
  invoices             Invoice[]
  truckDispatches      TruckDispatch[]
  factoryStuffings     FactoryStuffing[]
  gateIns              GateIn[]
  shippingInstructions ShippingInstruction[]
  billsOfLading        BillOfLading[]
  shippedOnBoards      ShippedOnBoard[]
  inventoryItems       InventoryItem[]
  inventoryMovements   InventoryMovement[]
  documents            Document[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@map("organizations")
}

model User {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  name           String
  role           Role
  phone          String?
  passwordHash   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customerProfile   Customer?              @relation("CustomerPortalUser")
  createdInvoices   Invoice[]              @relation("InvoiceCreatedBy")
  createdDispatches TruckDispatch[]        @relation("DispatchCreatedBy")
  createdStuffings  FactoryStuffing[]      @relation("StuffingCreatedBy")
  createdGateIns    GateIn[]               @relation("GateInCreatedBy")
  createdSIs        ShippingInstruction[]  @relation("SICreatedBy")
  createdBLs        BillOfLading[]         @relation("BLCreatedBy")
  createdSobs       ShippedOnBoard[]       @relation("SobCreatedBy")
  createdInventoryItems      InventoryItem[]      @relation("InventoryItemCreatedBy")
  recordedInventoryMovements InventoryMovement[]  @relation("InventoryMovementRecordedBy")
  uploadedDocuments Document[]             @relation("DocumentUploadedBy")
  comments          BookingComment[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  timelineEvents    BookingTimelineEvent[]
  authTokens        AuthToken[]

  @@index([organizationId])
  @@map("users")
}

enum AuthTokenType {
  PASSWORD_RESET
  INVITE
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  address        String?
  city           String?
  country        String?
  gstNumber      String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  /// Linked User for customer-portal login, if this customer has portal access.
  portalUserId   String?      @unique
  portalUser     User?        @relation("CustomerPortalUser", fields: [portalUserId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings Booking[]
  invoices Invoice[]

  @@index([organizationId])
  @@map("customers")
}

model Transporter {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  contactPhone   String?
  contactEmail   String?
  gstNumber      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  truckDispatches  TruckDispatch[]
  factoryStuffings FactoryStuffing[]

  @@index([organizationId])
  @@map("transporters")
}

// ---------------------------------------------------------------------------
// Booking master record
// ---------------------------------------------------------------------------

/// The single digital record a booking's Invoice → Dispatch → Stuffing →
/// Gate-In → SI → BL → SOB pipeline all attach to. One booking can now carry
/// multiple containers (FactoryStuffing rows) and multiple gate-ins.
model Booking {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingNumber  String       @unique
  bookingDate    DateTime     @default(now())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  exporterName   String?
  buyerName      String?
  pol            String?
  pod            String?
  shippingLine   String?
  vessel         String?
  etd            DateTime?
  eta            DateTime?
  freightTerms   String?
  commodity      String?
  currentStage   BookingStage @default(INVOICE)
  deliveryDate   DateTime?
  isDelayed      Boolean      @default(false)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoice             Invoice?
  truckDispatches     TruckDispatch[]
  factoryStuffings    FactoryStuffing[]
  gateIns             GateIn[]
  shippingInstruction ShippingInstruction?
  billOfLading        BillOfLading?
  sob                 ShippedOnBoard?
  inventoryMovements  InventoryMovement[]
  documents           Document[]
  comments            BookingComment[]
  timelineEvents      BookingTimelineEvent[]

  @@index([organizationId])
  @@index([customerId])
  @@map("bookings")
}

model BookingTimelineEvent {
  id          String       @id @default(uuid())
  bookingId   String
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stage       BookingStage
  title       String
  description String?
  occurredAt  DateTime     @default(now())
  actorId     String?
  actor       User?        @relation(fields: [actorId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([bookingId])
  @@map("booking_timeline_events")
}

model BookingComment {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@map("booking_comments")
}

// ---------------------------------------------------------------------------
// Step 1 — Export Invoice
// ---------------------------------------------------------------------------

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoiceNumber  String
  invoiceDate    DateTime
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  buyerName      String
  buyerAddress   String?
  poNumber       String?
  material       String
  quantity       Decimal       @db.Decimal(14, 3)
  quantityUnit   String        @default("MT")
  weight         Decimal       @db.Decimal(14, 3)
  weightUnit     String        @default("KG")
  numberOfBlocks Int?
  hsnCode        String
  unitPrice      Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  gstPercent     Decimal       @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal       @db.Decimal(14, 2)
  exportCountry  String
  status         InvoiceStatus @default(DRAFT)
  pdfUrl         String?

  createdById String?
  createdBy   User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions  InvoiceVersion[]
  documents Document[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceVersion {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  changeNote    String?
  changedById   String?
  createdAt     DateTime @default(now())

  @@unique([invoiceId, versionNumber])
  @@map("invoice_versions")
}

// ---------------------------------------------------------------------------
// Step 2 — Truck Dispatch
// ---------------------------------------------------------------------------

model TruckDispatch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  truckNumber            String
  driverName             String
  driverMobile           String
  transporterId          String
  transporter            Transporter    @relation(fields: [transporterId], references: [id])
  material               String
  referenceNumber        String?
  lrNumber               String?
  numberOfWeights        Decimal?       @db.Decimal(14, 3)
  numberOfBlocks         Int?
  dispatchDate           DateTime
  expectedFactoryArrival DateTime
  actualFactoryArrival   DateTime?
  status                 DispatchStatus @default(PENDING)

  createdById String?
  createdBy   User?    @relation("DispatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  factoryStuffing   FactoryStuffing? @relation(fields: [factoryStuffingId], references: [id])
  factoryStuffingId String?
  documents         Document[]

  @@index([organizationId])
  @@index([bookingId])
  @@index([transporterId])
  @@map("truck_dispatches")
}

// ---------------------------------------------------------------------------
// Step 3 — Factory Stuffing (one row per container; unlimited per booking)
// ---------------------------------------------------------------------------

model FactoryStuffing {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  containerNumber   String
  containerSize     ContainerSize
  commodity         String?
  sealNumber        String?
  contactPerson     String?
  contactNumber     String?
  transporterId     String?
  transporter       Transporter?  @relation(fields: [transporterId], references: [id])
  pol               String
  pod               String
  numberOfBoxes     Int?
  numberOfBlocks    Int?
  grossWeight       Decimal?      @db.Decimal(14, 3)
  netWeight         Decimal?      @db.Decimal(14, 3)
  lrGrNumber        String?
  deliveryDate      DateTime?
  actualArrival     DateTime?
  stuffingStartTime DateTime?
  stuffingEndTime   DateTime?

  checklistContainerClean    Boolean @default(false)
  checklistContainerDamage   Boolean @default(false)
  checklistSealApplied       Boolean @default(false)
  checklistDocumentsUploaded Boolean @default(false)

  remarks   String?
  status    StuffingStatus @default(SCHEDULED)
  reportUrl String?

  createdById String?
  createdBy   User?    @relation("StuffingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  truckDispatches TruckDispatch[]
  gateIn          GateIn?
  documents       Document[]

  @@index([organizationId])
  @@index([bookingId])
  @@map("factory_stuffings")
}

// ---------------------------------------------------------------------------
// Step 4 — Gate In (one per container, so many per booking)
// ---------------------------------------------------------------------------

model GateIn {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId         String
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  factoryStuffingId String          @unique
  factoryStuffing   FactoryStuffing @relation(fields: [factoryStuffingId], references: [id], onDelete: Cascade)

  containerNumber String
  gateInDate      DateTime
  terminal        String
  yard            String?
  vehicleNumber   String?
  form13Updated   Boolean      @default(false)
  gatePass        String?
  eirNumber       String?
  remarks         String?
  status          GateInStatus @default(PENDING)

  createdById String?
  createdBy   User?    @relation("GateInCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents Document[]

  @@index([organizationId])
  @@index([bookingId])
  @@map("gate_ins")
}

// ---------------------------------------------------------------------------
// Step 5 — Shipping Instruction
// ---------------------------------------------------------------------------

model ShippingInstruction {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  consignorName      String
  consignorAddress   String?
  consigneeName      String
  consigneeAddress   String?
  notifyPartyName    String?
  notifyPartyAddress String?
  pol                String
  pod                String
  commodity          String
  hsCode             String?
  packageCount       Int?
  weight             Decimal?  @db.Decimal(14, 3)
  marks              String?
  containerNumber    String?
  sealNumber         String?
  freightTerms       String?
  incoterms          String?
  shippingLine       String?
  voyage             String?
  vessel             String?
  status             SIStatus  @default(DRAFT)
  pdfUrl             String?
  sentAt             DateTime?

  createdById String?
  createdBy   User?    @relation("SICreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billOfLading BillOfLading?
  documents    Document[]

  @@index([organizationId])
  @@map("shipping_instructions")
}

// ---------------------------------------------------------------------------
// Step 6 — Bill of Lading
// ---------------------------------------------------------------------------

model BillOfLading {
  id                    String              @id @default(uuid())
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId             String              @unique
  booking               Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  shippingInstructionId String              @unique
  shippingInstruction   ShippingInstruction @relation(fields: [shippingInstructionId], references: [id], onDelete: Cascade)

  blNumber           String?
  blDate             DateTime?
  consignorName      String
  consignorAddress   String?
  consigneeName      String
  consigneeAddress   String?
  notifyPartyName    String?
  notifyPartyAddress String?
  pol                String
  pod                String
  vessel             String?
  voyage             String?
  containerNumber    String?
  sealNumber         String?
  commodity          String
  packageCount       Int?
  weight             Decimal?  @db.Decimal(14, 3)
  freightTerms       String?
  status             BLStatus  @default(DRAFT)
  mismatchNotes      Json?
  pdfUrl             String?

  createdById String?
  createdBy   User?    @relation("BLCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  revisions BLRevision[]
  documents Document[]
  sob       ShippedOnBoard?

  @@index([organizationId])
  @@map("bills_of_lading")
}

model BLRevision {
  id             String       @id @default(uuid())
  billOfLadingId String
  billOfLading   BillOfLading @relation(fields: [billOfLadingId], references: [id], onDelete: Cascade)
  revisionNumber Int
  snapshot       Json
  changeNote     String?
  changedById    String?
  createdAt      DateTime     @default(now())

  @@unique([billOfLadingId, revisionNumber])
  @@map("bl_revisions")
}

// ---------------------------------------------------------------------------
// Step 7 — Shipped On Board (created once the BL is finalized)
// ---------------------------------------------------------------------------

model ShippedOnBoard {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  billOfLadingId String       @unique
  billOfLading   BillOfLading @relation(fields: [billOfLadingId], references: [id], onDelete: Cascade)

  vessel       String?
  shippingLine String?
  sobDate      DateTime?
  remarks      String?
  status       SobStatus @default(PENDING)

  createdById String?
  createdBy   User?    @relation("SobCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@map("shipped_on_boards")
}

// ---------------------------------------------------------------------------
// Inventory — warehouse/godown stock exporters draw on when stuffing
// containers. Deliberately not wired into the booking-stage machine: a
// movement can *reference* a booking for traceability, but never drives
// currentStage — that stays owned by SOB/stuffing/etc.
// ---------------------------------------------------------------------------

model InventoryItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  sku          String?
  hsnCode      String?
  category     String?
  unit         String
  currentStock Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal? @db.Decimal(14, 3)
  unitValue    Decimal? @db.Decimal(14, 2)
  location     String?
  notes        String?

  createdById String?
  createdBy   User?    @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements InventoryMovement[]

  @@index([organizationId])
  @@map("inventory_items")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  quantity Decimal               @db.Decimal(14, 3)
  reason   String?

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  recordedById String?
  recordedBy   User?    @relation("InventoryMovementRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([organizationId])
  @@index([itemId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Documents (shared across every module)
// ---------------------------------------------------------------------------

model Document {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  entityType        String
  category          DocumentCategory
  fileName          String
  fileUrl           String
  fileType          String?
  fileSizeBytes     Int?
  ocrText           String?
  version           Int              @default(1)
  previousVersionId String?          @unique
  previousVersion   Document?        @relation("DocumentVersionHistory", fields: [previousVersionId], references: [id])
  nextVersion       Document?        @relation("DocumentVersionHistory")

  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  invoiceId             String?
  invoice               Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  truckDispatchId       String?
  truckDispatch         TruckDispatch?       @relation(fields: [truckDispatchId], references: [id], onDelete: Cascade)
  factoryStuffingId     String?
  factoryStuffing       FactoryStuffing?     @relation(fields: [factoryStuffingId], references: [id], onDelete: Cascade)
  gateInId              String?
  gateIn                GateIn?              @relation(fields: [gateInId], references: [id], onDelete: Cascade)
  shippingInstructionId String?
  shippingInstruction   ShippingInstruction? @relation(fields: [shippingInstructionId], references: [id], onDelete: Cascade)
  billOfLadingId        String?
  billOfLading          BillOfLading?        @relation(fields: [billOfLadingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bookingId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String
  body           String?
  entityType     String?
  entityId       String?
  isRead         Boolean             @default(false)
  createdAt      DateTime            @default(now())

  @@index([organizationId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log (generic, polymorphic — technical change history)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String
  entityId       String
  action         AuditAction
  changes        Json?
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
